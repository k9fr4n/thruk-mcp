        "backends": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backends"
        }
      },
      "title": "thruk_list_servicesArguments",
      "type": "object"
    }
  },
