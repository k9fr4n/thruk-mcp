        },
        "custom_vars": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Vars",
          "description": "Filter by service-level Nagios custom variables. Dict of {VARNAME: value} pairs translated to _VARNAME=value REST params. Example: {\"CRITICALITY\": \"prod\"}."
        },
        "host_custom_vars": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
