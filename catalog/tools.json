  {
    "name": "thruk_problems",
    "description": "List all current unhandled host/service problems (not acknowledged, not in downtime). Sorted by worst state first. Default columns are tight; pass `columns=''` for all. Optional `custom_vars` restricts by Nagios custom variables; `host_custom_vars` restricts service problems by host-level custom variables.",
    "inputSchema": {
      "properties": {
        "limit": {
          "default": 100,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "title": "Offset",
          "type": "integer"
        },
        "columns": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "custom_vars": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Vars",
          "description": "Filter problems by Nagios custom variables (host own vars in the hosts query, service own vars in the services query). Example: {\"ENV\": \"prod\"}."
        },
        "host_custom_vars": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host Custom Vars",
          "description": "Filter service problems by host-level Nagios custom variables. Translated to _HOSTVARNAME=value. Example: {\"KERNEL\": \"windows\"}."
        },
        "backends": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backends"
        },
        "hostgroup": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hostgroup",
          "description": "Restrict both hosts and services sub-queries to hosts belonging to this hostgroup name (exact match via groups[gte] / host_groups[gte]). Example: linux-servers."
        }
      },
      "title": "thruk_problemsArguments",
      "type": "object"
    }
  },
