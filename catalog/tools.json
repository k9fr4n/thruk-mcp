[
  {
    "name": "thruk_list_hosts",
    "description": "List monitored hosts. Filters: `hostgroup`, `state` (up/down/unreachable), `name_regex` (CI regex), `custom_vars` (Nagios custom variables, e.g. {\"KERNEL\": \"windows\"}). Pagination: `limit` (max 1000), `offset`. Sort: `sort` (e.g. 'name', '-state'). Columns: by default a tight subset is returned to save tokens. Pass an empty string `columns=''` to return ALL columns, or a custom comma list.",
    "inputSchema": {
      "properties": {
        "hostgroup": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hostgroup"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "name_regex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Regex"
        },
        "custom_vars": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Vars",
          "description": "Filter by Nagios custom variables. Dict of {VARNAME: value} pairs translated to Thruk REST _VARNAME=value params (auto-uppercased). Example: {\"KERNEL\": \"windows\"}."
        },
        "limit": {
          "default": 50,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "title": "Offset",
          "type": "integer"
        },
        "sort": {
          "default": "name",
          "title": "Sort",
          "type": "string"
        },
        "columns": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "backends": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backends"
        }
      },
      "title": "thruk_list_hostsArguments",
      "type": "object"
    }
  },
